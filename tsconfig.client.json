{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    // The screens still being ported are plain JS. `allowJs` without `checkJs`
    // types them for their TypeScript callers and reports nothing inside them.
    "allowJs": true
  },
  "include": ["client/**/*.ts", "client/**/*.tsx", "client/**/*.js", "vite.config.ts"]
}
