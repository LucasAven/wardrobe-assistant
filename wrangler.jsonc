{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wardrobe",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"preview_urls": false,
	// `not_found_handling: "single-page-application"` makes the asset worker answer
	// any unmatched path with index.html, and it runs before this Worker. That
	// swallowed `/authorize`, so Claude's consent screen came back as the web app
	// and OAuth could never finish. `run_worker_first` lists the paths this Worker
	// owns. Everything else, including every real file in ./public and the SPA
	// fallback the client-side router needs, still goes to the asset worker.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/authorize",
			"/oauth/*",
			"/mcp",
			"/sse",
			"/.well-known/*",
			"/api/*",
			"/img/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wardrobe",
			"database_id": "4efa0c17-184d-43b7-b87e-2085a74d92c8"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "wardrobe-photos"
		}
	],
	// Background removal. `segment: "foreground"` runs BiRefNet server side, so
	// nothing is downloaded to the phone and no third party API is involved.
	"images": {
		"binding": "IMAGES"
	},
	// Required by @cloudflare/workers-oauth-provider, which is the only way
	// Claude will connect a custom connector. There is no shared-token path.
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "49fba797c18544849fc8ce29755eb3a4"
		}
	],
	"observability": {
		"enabled": true
	}
}