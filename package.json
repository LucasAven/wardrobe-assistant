{
  "name": "wardrobe-assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "lint": "eslint .",
    "test": "vitest run && node test/ui.selftest.mjs",
    "db:migrate": "./scripts/migrate.sh --local",
    "db:migrate:remote": "./scripts/migrate.sh --remote"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tanstack/react-query": "^5.103.1",
    "agents": "^0.22.0",
    "hono": "^4.13.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
