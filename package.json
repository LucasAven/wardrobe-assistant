{
  "name": "wardrobe-assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node test/ui.selftest.mjs",
    "db:local": "wrangler d1 execute wardrobe --local --file=src/db/schema.sql",
    "db:remote": "wrangler d1 execute wardrobe --remote --file=src/db/schema.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.22.0",
    "hono": "^4.13.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
