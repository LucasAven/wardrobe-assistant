# Copy this file to `.dev.vars` for local development. That is the name wrangler
# reads, and it is gitignored. In production none of these are files at all,
# each one is set once with `npx wrangler secret put NAME`.
#
# The bindings this app needs (D1, R2, KV, Images) are not environment variables
# and are not listed here. They live in `wrangler.jsonc`, and `./scripts/setup.sh`
# creates them and writes their ids in for you.


# The password for the whole app, and the only credential in it. One value covers
# both front doors: the web login, and the consent screen Claude sends you to when
# you add the connector. Any string you want, there is no format requirement. It
# is never stored or compared in the clear, both sides go through HMAC-SHA256
# first. Required, and with it unset every authenticated route answers 503 and
# names the command that fixes it.
APP_PASSWORD=

# Signs the session cookie. Any long random string, generated with:
#   openssl rand -base64 32
# Required, and checked as a pair with APP_PASSWORD so a deployment missing one
# cannot let anybody in on the strength of the other.
SESSION_SECRET=

# Optional. This is the only API key in the project and the Claude connector never
# reads it, so if you ask Claude what to wear rather than using the button in the
# app, you can leave it unset forever.
#
# It buys exactly two things, both inside the web app. The vision pass that fills
# in a garment's type, warmth, formality and silhouette right after you photograph
# it, and the "recommend" button that composes an outfit without leaving the PWA.
#
# Unset, neither one breaks anything. An upload still returns 201 and still stores
# the photo, the garment just arrives blank and waits to be tagged, which the
# connector can do instead. The recommend route answers 503 and says which key is
# missing. Everything else, including the whole MCP server, runs untouched.
ANTHROPIC_API_KEY=
